managed implementation in class ZBP_R_ALLOCATION97 unique;
strict ( 2 );
with draft;
extensible;
define behavior for ZR_ALLOCATION97 alias Allocation
persistent table ZALLOCATION97
extensible
draft table ZALLOCATION_D97
etag master LocalLastChangedAt
lock master total etag LastChangedAt
authorization master( global )
{
  field ( readonly )
   Status,
   UUID,
   LocalCreatedBy,
   LocalCreatedAt,
   LocalLastChangedBy,
   LocalLastChangedAt,
   LastChangedAt;

  field ( numbering : managed )
   UUID;


  create;
  update;
  delete;

  validation validateAllocation on save { field begindate, enddate, quantity; create; update; }
  determination setInitialStatus on modify { create; }

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare;

  mapping for ZALLOCATION97 corresponding extensible
  {
    UUID = UUID;
    AllocationUUID = ALLOCATION_UUID;
    EmployeeID = EMPLOYEE_ID;
    EmployeeName = EMPLOYEE_NAME;
    EquipmentType = EQUIPMENT_TYPE;
    Quantity = QUANTITY;
    EquipmentValue = EQUIPMENT_VALUE;
    BeginDate = BEGIN_DATE;
    EndDate = END_DATE;
    Status = STATUS;
    CurrencyField = CURRENCY_FIELD;
    LocalCreatedBy = LOCAL_CREATED_BY;
    LocalCreatedAt = LOCAL_CREATED_AT;
    LocalLastChangedBy = LOCAL_LAST_CHANGED_BY;
    LocalLastChangedAt = LOCAL_LAST_CHANGED_AT;
    LastChangedAt = LAST_CHANGED_AT;
  }

}